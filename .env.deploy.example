# Anotato - Google Cloud Run Deployment Configuration
# Copy this file to .env.deploy and set your project details:
#   cp .env.deploy.example .env.deploy

# Google Cloud Project ID (Required)
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Region (Default: us-central1)
GCP_REGION=us-central1

# Cloud Run Service Name (Default: anotato)
SERVICE_NAME=anotato

# Container Port (Default: 8080)
PORT=8080

# Concurrency per container instance (Default: 80)
CONCURRENCY=80

# Minimum instances (Default: 0 for scale-to-zero / zero idle costs)
MIN_INSTANCES=0

# Maximum instances (Default: 5 for bot/cost guardrail)
MAX_INSTANCES=5
